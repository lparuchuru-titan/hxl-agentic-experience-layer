{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": {
            "gap": "md",
            "padding": "md"
          },
          "children": [
            {
              "definition": "tile/card",
              "attributes": {
                "padding": "lg",
                "variant": "elevated"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center",
                    "justify": "between"
                  },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.caseNumber}",
                        "variant": "caption"
                      }
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm",
                        "align": "center"
                      },
                      "children": [
                        {
                          "definition": "tile/badge",
                          "attributes": {
                            "label": "{!$attrs.priority}",
                            "variant": "secondary"
                          }
                        },
                        {
                          "definition": "tile/badge",
                          "attributes": {
                            "label": "SLA",
                            "variant": "warning"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "{!$attrs.subject}",
                    "variant": "h2"
                  }
                },
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "{!$attrs.customerName}",
                    "variant": "caption"
                  }
                },
                {
                  "definition": "tile/separator"
                },
                {
                  "definition": "tile/callout",
                  "meta": {
                    "if": "{!$attrs.slaAtRisk}"
                  },
                  "attributes": {
                    "variant": "warning",
                    "title": "SLA at risk"
                  },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.slaHoursLeft}",
                        "variant": "body"
                      }
                    }
                  ]
                },
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "Recommended next action",
                    "variant": "h3"
                  }
                },
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "{!$attrs.recommendedAction}",
                    "variant": "body"
                  }
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center"
                  },
                  "children": [
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Take next action",
                        "variant": "primary"
                      }
                    },
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "View case",
                        "variant": "secondary"
                      }
                    }
                  ]
                },
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "{!$attrs.ownerName}",
                    "variant": "caption"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
