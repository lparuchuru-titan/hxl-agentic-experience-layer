                    "gap": "sm",
                    "align": "center"
                  },
                  "children": [
                    {
                      "definition": "tile/badge",
                      "attributes": {
                        "label": "{!$case.priority}",
                        "variant": "secondary"
                      }
                    },
                    {
                      "definition": "tile/badge",
                      "attributes": {
                        "label": "SLA",
                        "variant": "warning"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "definition": "tile/text",
              "attributes": {
                "text": "{!$case.subject}",
                "variant": "h2"
              }
            },
            {
              "definition": "tile/text",
              "attributes": {
                "text": "{!$case.customerName}",
                "variant": "caption"
              }
            },
            {
              "definition": "tile/separator"
            },
            {
              "definition": "tile/callout",
              "meta": {
                "if": "{!$case.slaAtRisk}"
