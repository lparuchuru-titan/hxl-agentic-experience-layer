            {
              "definition": "tile/row",
              "attributes": {
                "gap": "sm",
                "align": "center"
              },
              "children": [
                {
                  "definition": "tile/button",
                  "attributes": {
                    "label": "Take next action",
                    "variant": "primary"
                  }
                },
                {
                  "definition": "tile/button",
                  "attributes": {
                    "label": "View case",
                    "variant": "secondary"
                  }
                }
              ]
            },
            {
              "definition": "tile/text",
              "attributes": {
                "text": "{!$case.ownerName}",
                "variant": "caption"
              }
